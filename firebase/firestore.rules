rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(pid) {
      return signedIn() && exists(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid)).data.active == true;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Profile command not implemented yet.
      match /projectRefs/{pid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /projects/{pid} {
      allow read: if member(pid);
      allow write: if false;
      match /{collection}/{id} {
        allow read: if collection in ['members', 'tasks', 'dependencies', 'messages', 'activity'] && member(pid);
        allow write: if false; // Trusted Functions own writes.
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
